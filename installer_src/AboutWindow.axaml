<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SeasonsInstaller.AboutWindow"
        Title="The Sims: Seasons"
        Icon="/Assets/setup.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False" CanMaximize="False" CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel>
    <Image Source="avares://SeasonsSetup/Assets/about.png" Stretch="None" />
    <Button Name="OkButton" Content="OK" Width="80" Margin="8"
            HorizontalAlignment="Center" HorizontalContentAlignment="Center"
            IsDefault="True" IsCancel="True" Click="OnOk" />
  </StackPanel>
</Window>
